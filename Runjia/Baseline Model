# ============================================================
# BASELINE MODEL: E. coli CRISPR sgRNA Cut-Score Prediction
# Project: Enhancing sgRNA efficiency in CRISPR-Cas9 genome editing
#
# This is the shared starting point the whole team builds on. It merges:
#   - Teammate A's leakage-safe per-fold CV framework (their Cells 2-7):
#     the feature selector is re-fit inside every fold, not once on all
#     data, so validation folds never leak into feature selection.
#   - Teammate B's production pipeline (their final training script):
#     trains a final model on 100% of the data and saves versioned
#     artifacts (model, selector, feature list, metadata, inference test)
#     for later use in the portal / GitHub.
#   - Fixes from our own iteration: no Google Colab dependency (runs
#     locally), fixed random_state everywhere for reproducibility,
#     n_estimators decoupled from n_features, and an optional grid-search
#     cell for retuning both together instead of guessing.
#
# Frozen "champion" baseline settings (leakage-safe optimum from the team's
# earlier grid search): N_FEATURES = 300, N_ESTIMATORS = 400.
# Retune via CELL 6 (RUN_GRID_SEARCH = True) before changing these.
#
# IMPORTANT: the number that should ever be reported/trusted as this
# model's performance is the CV score from CELL 7 (baseline['mean_r2'] /
# mean_spearman). The final model trained in CELL 8 is fit on all data
# and its in-sample fit is NOT a validation score.
# ============================================================

# %% CELL 0 — Install missing packages if needed (safe to skip if already set up)
import sys
import subprocess


def install_if_missing(import_name, pip_name=None):
    pip_name = pip_name or import_name
    try:
        __import__(import_name)
    except ImportError:
        print(f"Installing {pip_name}...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", pip_name])


for _mod, _pip in [
    ("numpy", None), ("pandas", None), ("sklearn", "scikit-learn"),
    ("scipy", None), ("xgboost", None), ("joblib", None),
]:
    install_if_missing(_mod, _pip)

# %% CELL 1 — Imports
import os
import json
import hashlib
import warnings

warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import xgboost as xgb
import joblib
from scipy.stats import spearmanr
from sklearn.model_selection import KFold
from sklearn.metrics import r2_score, mean_squared_error

# %% CELL 2 — Config (edit this cell for most experiments)
# Local path — no Google Drive mount needed. Point this at wherever the CSV
# lives on your machine. Swap in one of the QCT-engineered-feature variants
# here later without touching anything else in the script.
DATA_PATH = os.path.expanduser("~/Downloads/ecoli_feature_matrix.csv")

TARGET_COLUMN = "cut.score"

# Frozen baseline settings — tune via CELL 6, then set the winners here.
N_FEATURES = 300
N_ESTIMATORS = 400

N_SPLITS = 5
RANDOM_STATE = 42
SHUFFLE = True

OUTPUT_DIR = "champion_ecoli_xgboost_model"
os.makedirs(OUTPUT_DIR, exist_ok=True)

NON_FEATURE_COLUMNS = [
    "sgRNAID", "sequence", "Sequence", "sgRNA", "sgrna",
    "guide", "Guide", "guide_sequence", "GuideSequence",
    "target_sequence", "TargetSequence",
]

# Prefixes for engineered feature columns added by later feature-engineering
# scripts (regional QCT features, gene essentiality, etc.). Harmless if none
# of these columns exist yet in the current CSV — counts just read 0.
ENGINEERED_PREFIXES = ("regional_qct", "eng.")


def is_engineered_feature(name) -> bool:
    return str(name).strip().startswith(ENGINEERED_PREFIXES)


def engineered_family(name) -> str:
    s = str(name).strip()
    if s.startswith("regional_qct"):
        return "regional_qct"
    if s.startswith("eng."):
        return "eng_extra"
    return "original"


# XGBoost feature selector — always re-fit inside each fold, never on all data.
SELECTOR_PARAMS = dict(
    n_estimators=300, learning_rate=0.05, max_depth=4,
    subsample=0.8, colsample_bytree=0.8,
    reg_alpha=0.0, reg_lambda=1.0, min_child_weight=1,
    random_state=RANDOM_STATE, n_jobs=-1,
    tree_method="hist", importance_type="gain",
)

# XGBoost champion (prediction) model. n_estimators is supplied separately
# so it is never accidentally tied to n_features.
CHAMPION_PARAMS = dict(
    learning_rate=0.05, max_depth=4,
    subsample=0.8, colsample_bytree=0.8,
    reg_alpha=0.0, reg_lambda=1.0, min_child_weight=1,
    random_state=RANDOM_STATE, n_jobs=-1, tree_method="hist",
)

# %% CELL 3 — Helpers
def stable_spearman(y_true, y_pred) -> float:
    rho, _ = spearmanr(y_true, y_pred)
    return 0.0 if np.isnan(rho) else float(rho)


def median_impute_train_val(X_train, X_val):
    """Median-impute NaNs using stats fit on the TRAIN fold only (leakage-safe)."""
    X_train = X_train.astype(np.float32, copy=True)
    X_val = X_val.astype(np.float32, copy=True)
    medians = np.nanmedian(X_train, axis=0)
    medians = np.where(np.isnan(medians), 0.0, medians)
    tr_rows, tr_cols = np.where(np.isnan(X_train))
    va_rows, va_cols = np.where(np.isnan(X_val))
    X_train[tr_rows, tr_cols] = medians[tr_cols]
    X_val[va_rows, va_cols] = medians[va_cols]
    return X_train, X_val, medians


def median_impute_full(X):
    """Median-impute NaNs on the full dataset — used only for the final
    production model in CELL 8, never for the CV score in CELL 7."""
    X = X.astype(np.float32, copy=True)
    medians = np.nanmedian(X, axis=0)
    medians = np.where(np.isnan(medians), 0.0, medians)
    rows, cols = np.where(np.isnan(X))
    X[rows, cols] = medians[cols]
    return X, medians


def feature_name_hash(feature_names) -> str:
    payload = json.dumps(list(feature_names), separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


# %% CELL 4 — Load data
print(f"Loading: {DATA_PATH}")
df = pd.read_csv(DATA_PATH, header=1, low_memory=False)  # row 1 is a title row

required = {"sgRNAID", TARGET_COLUMN}
missing = required - set(df.columns)
if missing:
    raise ValueError(f"CSV is missing columns {missing}.")

df = df.dropna(subset=["sgRNAID", TARGET_COLUMN])
y = pd.to_numeric(df[TARGET_COLUMN], errors="coerce").to_numpy(dtype=np.float64)

drop_cols = [TARGET_COLUMN] + [c for c in NON_FEATURE_COLUMNS if c in df.columns]
X_df = df.drop(columns=drop_cols).apply(pd.to_numeric, errors="coerce")

all_nan_cols = X_df.columns[X_df.isna().all()].tolist()
if all_nan_cols:
    print(f"Dropping {len(all_nan_cols)} all-NaN columns.")
    X_df = X_df.drop(columns=all_nan_cols)

feature_names = list(X_df.columns)
engineered_mask = np.array([is_engineered_feature(n) for n in feature_names])
feature_family = np.array([engineered_family(n) for n in feature_names], dtype=object)

X_raw = X_df.to_numpy(dtype=np.float32)

valid_y = ~np.isnan(y)
if valid_y.sum() < len(y):
    print(f"Dropping {len(y) - valid_y.sum()} rows with missing {TARGET_COLUMN}.")
    X_raw = X_raw[valid_y]
    y = y[valid_y]

if N_FEATURES > X_raw.shape[1]:
    raise ValueError(f"N_FEATURES={N_FEATURES} exceeds available features ({X_raw.shape[1]}).")

feature_hash = feature_name_hash(feature_names)
print(f"Rows: {X_raw.shape[0]} | Raw features: {X_raw.shape[1]} | Target: {TARGET_COLUMN}")
print(
    f"Engineered features present: {int(engineered_mask.sum())} "
    f"(regional_qct={int((feature_family == 'regional_qct').sum())}, "
    f"eng.*={int((feature_family == 'eng_extra').sum())})"
)

# %% CELL 5 — Leakage-safe 5-fold CV (this is the number we report/trust)
def run_cv(n_features: int, n_estimators: int, verbose: bool = True) -> dict:
    """
    Per-fold feature selection: the selector is re-fit on the TRAIN split of
    each fold only, so no validation-fold information leaks into which
    features get chosen or into the imputation medians. This replaces the
    earlier version where the ranking was computed once on all data before
    CV even started.
    """
    kf = KFold(n_splits=N_SPLITS, shuffle=SHUFFLE, random_state=RANDOM_STATE)
    r2_scores, spearman_scores, mse_scores = [], [], []

    for fold, (train_idx, val_idx) in enumerate(kf.split(X_raw), start=1):
        X_tr_raw, X_val_raw = X_raw[train_idx], X_raw[val_idx]
        y_tr, y_val = y[train_idx], y[val_idx]
        X_tr, X_val, _ = median_impute_train_val(X_tr_raw, X_val_raw)

        selector = xgb.XGBRegressor(**SELECTOR_PARAMS)
        selector.fit(X_tr, y_tr)
        top_idx = np.argsort(selector.feature_importances_)[::-1][:n_features]

        model = xgb.XGBRegressor(n_estimators=n_estimators, **CHAMPION_PARAMS)
        model.fit(X_tr[:, top_idx], y_tr)
        preds = model.predict(X_val[:, top_idx])

        r2 = r2_score(y_val, preds)
        rho = stable_spearman(y_val, preds)
        mse = mean_squared_error(y_val, preds)
        r2_scores.append(r2)
        spearman_scores.append(rho)
        mse_scores.append(mse)
        if verbose:
            print(f"  Fold {fold}: R^2={r2:.4f} | Spearman={rho:.4f} | MSE={mse:.4f}")

    return {
        "n_features": n_features,
        "n_estimators": n_estimators,
        "mean_r2": float(np.mean(r2_scores)),
        "std_r2": float(np.std(r2_scores)),
        "mean_spearman": float(np.mean(spearman_scores)),
        "mean_mse": float(np.mean(mse_scores)),
        "fold_r2": r2_scores,
    }


# %% CELL 6 — (Optional) Grid search to retune N_FEATURES / N_ESTIMATORS
# Expensive: len(n_features_grid) x len(n_estimators_grid) x N_SPLITS fits.
# Leave RUN_GRID_SEARCH = False unless you're deliberately retuning the
# baseline — and when you do, prefer a coarse grid first, then narrow in.
RUN_GRID_SEARCH = False

if RUN_GRID_SEARCH:
    n_features_grid = [100, 200, 300, 400, 500, 600, 800, 1000]
    n_estimators_grid = [200, 400, 600]

    grid_results = []
    for nf in n_features_grid:
        for ne in n_estimators_grid:
            print(f"\n[Grid] n_features={nf} n_estimators={ne}")
            res = run_cv(nf, ne, verbose=False)
            grid_results.append(res)
            print(f"  -> R^2={res['mean_r2']:.4f} | Spearman={res['mean_spearman']:.4f}")
            pd.DataFrame(grid_results).drop(columns=["fold_r2"]).to_csv(
                "grid_search_results_partial.csv", index=False
            )

    grid_df = pd.DataFrame(grid_results)
    best_r2 = grid_df.loc[grid_df["mean_r2"].idxmax()]
    best_rho = grid_df.loc[grid_df["mean_spearman"].idxmax()]
    print(
        f"\nBest by R^2:       n_features={int(best_r2['n_features'])}, "
        f"n_estimators={int(best_r2['n_estimators'])}, R^2={best_r2['mean_r2']:.4f}, "
        f"Spearman={best_r2['mean_spearman']:.4f}"
    )
    print(
        f"Best by Spearman:  n_features={int(best_rho['n_features'])}, "
        f"n_estimators={int(best_rho['n_estimators'])}, R^2={best_rho['mean_r2']:.4f}, "
        f"Spearman={best_rho['mean_spearman']:.4f}"
    )
    print("(sgRNA ranking is the real use case — if these two disagree, weigh Spearman more.)")

# %% CELL 7 — Confirm the frozen baseline with leakage-safe CV
print("=" * 60)
print("BASELINE CV (leakage-safe: per-fold XGBoost feature selection)")
print(f"Data:         {os.path.basename(DATA_PATH)}")
print(f"n_features:   {N_FEATURES}")
print(f"n_estimators: {N_ESTIMATORS}")
print("=" * 60)

baseline = run_cv(N_FEATURES, N_ESTIMATORS, verbose=True)

print("\nBASELINE RESULTS")
print(f" Mean CV R^2:       {baseline['mean_r2']:.4f} ± {baseline['std_r2']:.4f}")
print(f" Mean CV Spearman:  {baseline['mean_spearman']:.4f}")
print(f" Mean CV MSE:       {baseline['mean_mse']:.4f}")

# %% CELL 8 — Train the final production model on ALL data
# This final selector/model is fit on 100% of the data and is what gets
# shipped. The CV score above (CELL 7), not this fit, is the number that
# estimates real-world performance — never report this model's in-sample
# score as if it were a validation score.
print("\nTraining final feature selector on all data...")
X_full, imputer_medians = median_impute_full(X_raw)

final_selector = xgb.XGBRegressor(**SELECTOR_PARAMS)
final_selector.fit(X_full, y)

importance_df = pd.DataFrame({
    "feature_index": np.arange(len(feature_names)),
    "feature_name": feature_names,
    "importance_gain": final_selector.feature_importances_,
}).sort_values("importance_gain", ascending=False)

selected_feature_indices = importance_df.head(N_FEATURES)["feature_index"].to_numpy()
selected_feature_names = [feature_names[i] for i in selected_feature_indices]
X_selected = X_full[:, selected_feature_indices]

print(f"Selected feature matrix shape: {X_selected.shape}")

champion_model = xgb.XGBRegressor(n_estimators=N_ESTIMATORS, **CHAMPION_PARAMS)
champion_model.fit(X_selected, y)
print("Final champion model trained.")

# %% CELL 9 — Save production artifacts
joblib.dump(champion_model, os.path.join(OUTPUT_DIR, "champion_xgboost_model.pkl"))
joblib.dump(final_selector, os.path.join(OUTPUT_DIR, "feature_selector_model.pkl"))
joblib.dump(selected_feature_indices, os.path.join(OUTPUT_DIR, "selected_feature_indices.pkl"))
np.save(os.path.join(OUTPUT_DIR, "imputer_medians.npy"), imputer_medians)

with open(os.path.join(OUTPUT_DIR, "full_feature_names_ordered.json"), "w") as f:
    json.dump(feature_names, f, indent=2)
with open(os.path.join(OUTPUT_DIR, "selected_feature_names_ordered.json"), "w") as f:
    json.dump(selected_feature_names, f, indent=2)

importance_df.to_csv(os.path.join(OUTPUT_DIR, "final_feature_importance_ranking.csv"), index=False)
pd.DataFrame({"r2": baseline["fold_r2"]}).to_csv(
    os.path.join(OUTPUT_DIR, "baseline_cv_folds.csv"), index=False
)

metadata = {
    "project": "Enhancing sgRNA efficiency in CRISPR-Cas9 genome editing",
    "species": "Escherichia coli",
    "data_path": DATA_PATH,
    "target_column": TARGET_COLUMN,
    "dropped_columns": drop_cols,
    "all_nan_columns_dropped": all_nan_cols,
    "x_shape_full": list(X_raw.shape),
    "x_shape_selected": list(X_selected.shape),
    "n_features": N_FEATURES,
    "n_estimators": N_ESTIMATORS,
    "random_state": RANDOM_STATE,
    "feature_order_hash": feature_hash,
    "selector_params": SELECTOR_PARAMS,
    "champion_params": {**CHAMPION_PARAMS, "n_estimators": N_ESTIMATORS},
    "cv_mean_r2": baseline["mean_r2"],
    "cv_std_r2": baseline["std_r2"],
    "cv_mean_spearman": baseline["mean_spearman"],
    "cv_mean_mse": baseline["mean_mse"],
}
with open(os.path.join(OUTPUT_DIR, "model_metadata.json"), "w") as f:
    json.dump(metadata, f, indent=2)

